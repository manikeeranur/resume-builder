# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string
MONGO_URI=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — Google sign-in only appears when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (profile photo uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Razorpay — get test-mode keys from the Razorpay dashboard (Test Mode
# toggle, top right) before ever switching to live keys. The webhook secret
# is set separately when you register the webhook URL under
# Settings > Webhooks in the dashboard.
# Only NEXT_PUBLIC_RAZORPAY_KEY_ID may be exposed to the browser — it is the
# same value as RAZORPAY_KEY_ID, duplicated under the NEXT_PUBLIC_ prefix so
# Checkout can use it client-side. Never prefix the secret or webhook secret
# with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Email (optional) — SMTP for payment/subscription notification emails.
# Leave unset to run without email (sends are logged to the console instead
# of failing). Works with any SMTP provider (Gmail app password, Amazon SES,
# Mailtrap for testing, your own mail server, etc.) — no specific paid email
# service is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM_NAME=ResumePro

# Invoices (optional — used on the generated invoice PDF; falls back to
# generic defaults if unset)
INVOICE_COMPANY_NAME=ResumePro
INVOICE_SUPPORT_EMAIL=support@example.com

# PDF watermark text shown on free-plan downloads (optional)
WATERMARK_TEXT=ResumePro

# Cron auth (required for /api/cron/subscription-reminders to run) — Vercel
# Cron sends this as `Authorization: Bearer <value>` on its scheduled hits
# (see vercel.json); the route 401s without a match. Generate one with
# `openssl rand -hex 32` and set the same value in the Vercel project's
# Environment Variables when you deploy.
CRON_SECRET=
