    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "restart": "kill -9 $(lsof -ti:3000) 2>/dev/null; npm run predev; next dev -p 3000",
    "seed:plans": "node --env-file=.env scripts/seedPlans.mjs",
    "admin:promote": "node --env-file=.env scripts/promoteAdmin.mjs",
    "generate:template-styles": "node --env-file-if-exists=.env scripts/generateTemplateClassScan.mjs"
  },
